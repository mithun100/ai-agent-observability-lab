        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "GenAI Operations in Previous 5 Minutes",
      "id": 13,
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Estimated model operations during the rolling five-minute window. One travel-plan request may generate multiple model operations.",
