      "gridPos": {
        "x": 4,
        "y": 3,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round((sum(gen_ai_client_operation_duration_seconds_count) - (sum(gen_ai_client_operation_duration_seconds_count offset $__range) or vector(0))))",
          "legendFormat": "calls",
