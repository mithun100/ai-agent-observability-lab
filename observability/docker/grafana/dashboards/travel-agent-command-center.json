    {
      "type": "stat",
      "title": "Avg time per plan",
      "description": "End-to-end latency of /travel/plan, averaged over the selected range.",
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(traces_span_metrics_duration_seconds_sum{span_name=\"POST /travel/plan\"}) - (sum(traces_span_metrics_duration_seconds_sum{span_name=\"POST /travel/plan\"} offset $__range) or vector(0))) / (sum(traces_span_metrics_duration_seconds_count{span_name=\"POST /travel/plan\"}) - (sum(traces_span_metrics_duration_seconds_count{span_name=\"POST /travel/plan\"} offset $__range) or vector(0)))",
          "legendFormat": "avg",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "#f2cc60"
          },
          "noValue": "\u2013",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#f2cc60",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "wideLayout": true
      }
    },
    {
      "type": "stat",
      "title": "Est. cost per plan",
      "description": "Tokens x list price. Edit the price_in / price_out variables (USD per 1M tokens) at the top.",
      "id": 6,
      "gridPos": {
        "x": 16,
        "y": 3,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "((sum(gen_ai_client_token_usage_sum{gen_ai_token_type=\"input\"}) - (sum(gen_ai_client_token_usage_sum{gen_ai_token_type=\"input\"} offset $__range) or vector(0))) * $price_in + (sum(gen_ai_client_token_usage_sum{gen_ai_token_type=\"output\"}) - (sum(gen_ai_client_token_usage_sum{gen_ai_token_type=\"output\"} offset $__range) or vector(0))) * $price_out) / 1000000 / (sum(traces_span_metrics_calls_total{span_name=\"POST /travel/plan\"}) - (sum(traces_span_metrics_calls_total{span_name=\"POST /travel/plan\"} offset $__range) or vector(0)))",
          "legendFormat": "cost",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "#ff8068"
          },
          "noValue": "\u2013",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#ff8068",
                "value": null
              }
            ]
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "wideLayout": true
      }
    },
    {
      "type": "stat",
      "title": "Slowest agent",
      "description": "Agent whose step takes longest on average.",
      "id": 7,
      "gridPos": {
        "x": 20,
        "y": 3,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(1, (sum by (agent) (label_replace(traces_span_metrics_duration_seconds_sum{span_name=~\"execute_task (coordinator|flight_specialist|hotel_specialist|activity_specialist|plan_synthesizer)\"},\"agent\",\"$1\",\"span_name\",\"execute_task (.*)\")) - (sum by (agent) (label_replace(traces_span_metrics_duration_seconds_sum{span_name=~\"execute_task (coordinator|flight_specialist|hotel_specialist|activity_specialist|plan_synthesizer)\"} offset $__range,\"agent\",\"$1\",\"span_name\",\"execute_task (.*)\")) or sum by (agent) (label_replace(traces_span_metrics_duration_seconds_sum{span_name=~\"execute_task (coordinator|flight_specialist|hotel_specialist|activity_specialist|plan_synthesizer)\"},\"agent\",\"$1\",\"span_name\",\"execute_task (.*)\")) * 0)) / (sum by (agent) (label_replace(traces_span_metrics_duration_seconds_count{span_name=~\"execute_task (coordinator|flight_specialist|hotel_specialist|activity_specialist|plan_synthesizer)\"},\"agent\",\"$1\",\"span_name\",\"execute_task (.*)\")) - (sum by (agent) (label_replace(traces_span_metrics_duration_seconds_count{span_name=~\"execute_task (coordinator|flight_specialist|hotel_specialist|activity_specialist|plan_synthesizer)\"} offset $__range,\"agent\",\"$1\",\"span_name\",\"execute_task (.*)\")) or sum by (agent) (label_replace(traces_span_metrics_duration_seconds_count{span_name=~\"execute_task (coordinator|flight_specialist|hotel_specialist|activity_specialist|plan_synthesizer)\"},\"agent\",\"$1\",\"span_name\",\"execute_task (.*)\")) * 0)))",
          "legendFormat": "{{agent}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "#ff8068"
          },
          "noValue": "\u2013",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#ff8068",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "wideLayout": true
      }
    },
    {
      "type": "row",
      "title": "Agent breakdown: who is slow, who is expensive",
      "collapsed": false,
