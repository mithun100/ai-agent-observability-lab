{
  "uid": "travel-agent-cc",
  "title": "Travel Agent Command Center",
  "description": "One view of the multi-agent travel planner: throughput, cost, per-agent time and tokens, latency, traces, logs.",
  "tags": [
    "otel",
    "genai",
    "agents",
    "session1"
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "refresh": "10s",
  "schemaVersion": 39,
  "style": "dark",
  "templating": {
    "list": [
      {
        "name": "price_in",
        "label": "USD / 1M input tokens",
        "type": "textbox",
        "query": "0.8",
        "current": {
          "text": "0.8",
          "value": "0.8"
        },
        "options": [
          {
            "selected": true,
            "text": "0.8",
            "value": "0.8"
          }
        ],
        "hide": 0
      },
      {
        "name": "price_out",
        "label": "USD / 1M output tokens",
        "type": "textbox",
        "query": "3.2",
        "current": {
          "text": "3.2",
          "value": "3.2"
        },
        "options": [
          {
            "selected": true,
            "text": "3.2",
            "value": "3.2"
          }
        ],
        "hide": 0
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "version": 2,
  "weekStart": "",
  "panels": [
    {
      "type": "text",
      "title": "",
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "transparent": true,
      "options": {
        "mode": "html",
        "content": "<div style=\"display:flex;align-items:center;gap:18px;flex-wrap:wrap;padding:2px 4px\"><span style=\"font-size:24px;font-weight:600;letter-spacing:-0.02em\">Travel Agent Observability</span><span style=\"color:#d5f36a\">5 agents</span><span style=\"opacity:.5\">\u00b7</span><span style=\"color:#86baf0\">Amazon Bedrock \u00b7 Nova Pro</span><span style=\"opacity:.5\">\u00b7</span><span style=\"color:#ff8068\">OpenTelemetry</span><span style=\"opacity:.5\">\u2192</span><span style=\"color:#83d8c4\">Prometheus \u00b7 Tempo \u00b7 Loki</span><span style=\"opacity:.6;margin-left:auto\">coordinator \u2192 flight \u2192 hotel \u2192 activity \u2192 synthesizer</span></div>"
      }
    },
    {
      "type": "stat",
      "title": "Travel plans",
      "description": "Completed /travel/plan requests in the selected time range.",
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round((sum(traces_span_metrics_calls_total{span_name=\"POST /travel/plan\"}) - (sum(traces_span_metrics_calls_total{span_name=\"POST /travel/plan\"} offset $__range) or vector(0))))",
          "legendFormat": "plans",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#d5f36a"
          },
          "noValue": "\u2013",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d5f36a",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "wideLayout": true
      }
    },
    {
      "type": "stat",
      "title": "Model calls",
      "description": "Calls to the LLM in the selected range. One plan fans out into several calls.",
