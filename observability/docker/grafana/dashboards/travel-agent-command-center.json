    {
      "type": "bargauge",
      "title": "Where the time goes",
      "description": "Average duration of each agent's step (includes its model calls). Source: spans via the collector.",
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (agent) (label_replace(traces_span_metrics_duration_seconds_sum{span_name=~\"execute_task (coordinator|flight_specialist|hotel_specialist|activity_specialist|plan_synthesizer)\"},\"agent\",\"$1\",\"span_name\",\"execute_task (.*)\")) - (sum by (agent) (label_replace(traces_span_metrics_duration_seconds_sum{span_name=~\"execute_task (coordinator|flight_specialist|hotel_specialist|activity_specialist|plan_synthesizer)\"} offset $__range,\"agent\",\"$1\",\"span_name\",\"execute_task (.*)\")) or sum by (agent) (label_replace(traces_span_metrics_duration_seconds_sum{span_name=~\"execute_task (coordinator|flight_specialist|hotel_specialist|activity_specialist|plan_synthesizer)\"},\"agent\",\"$1\",\"span_name\",\"execute_task (.*)\")) * 0)) / (sum by (agent) (label_replace(traces_span_metrics_duration_seconds_count{span_name=~\"execute_task (coordinator|flight_specialist|hotel_specialist|activity_specialist|plan_synthesizer)\"},\"agent\",\"$1\",\"span_name\",\"execute_task (.*)\")) - (sum by (agent) (label_replace(traces_span_metrics_duration_seconds_count{span_name=~\"execute_task (coordinator|flight_specialist|hotel_specialist|activity_specialist|plan_synthesizer)\"} offset $__range,\"agent\",\"$1\",\"span_name\",\"execute_task (.*)\")) or sum by (agent) (label_replace(traces_span_metrics_duration_seconds_count{span_name=~\"execute_task (coordinator|flight_specialist|hotel_specialist|activity_specialist|plan_synthesizer)\"},\"agent\",\"$1\",\"span_name\",\"execute_task (.*)\")) * 0))",
          "legendFormat": "{{agent}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#f2cc60"
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "top",
        "minVizHeight": 16,
        "minVizWidth": 8,
        "sizing": "auto",
        "legend": {
          "showLegend": false
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "barchart",
      "title": "Who spends the tokens",
      "id": 10,
      "gridPos": {
        "x": 8,
        "y": 9,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Input (blue) and output (coral) tokens per agent. Specialists read a lot; the coordinator and synthesizer write a lot.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (traceloop_association_properties_agent_name) (agent_llm_tokens_input_sum) - (sum by (traceloop_association_properties_agent_name) (agent_llm_tokens_input_sum offset $__range) or sum by (traceloop_association_properties_agent_name) (agent_llm_tokens_input_sum) * 0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (traceloop_association_properties_agent_name) (agent_llm_tokens_output_sum) - (sum by (traceloop_association_properties_agent_name) (agent_llm_tokens_output_sum offset $__range) or sum by (traceloop_association_properties_agent_name) (agent_llm_tokens_output_sum) * 0))",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "traceloop_association_properties_agent_name",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true
            },
            "renameByName": {
              "traceloop_association_properties_agent_name": "agent",
              "Value #A": "input tokens",
              "Value #B": "output tokens"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "axisPlacement": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "input tokens"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#86baf0"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "output tokens"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#ff8068"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "xField": "agent",
        "barWidth": 0.85,
        "groupWidth": 0.75,
        "stacking": "none",
        "showValue": "always",
        "xTickLabelRotation": 0,
        "fullHighlight": false,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Token flow over time",
      "id": 11,
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Input vs output tokens per minute. Output tokens are what you wait for.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(gen_ai_client_token_usage_sum{gen_ai_token_type=\"input\"}[$__rate_interval]))",
          "legendFormat": "input",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(gen_ai_client_token_usage_sum{gen_ai_token_type=\"output\"}[$__rate_interval]))",
          "legendFormat": "output",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
