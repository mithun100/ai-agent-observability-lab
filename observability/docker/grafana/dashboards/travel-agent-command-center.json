        },
        "wideLayout": true
      }
    },
    {
      "type": "stat",
      "title": "Tokens used",
      "description": "Input plus output tokens reported by the model in the selected range.",
      "id": 4,
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(gen_ai_client_token_usage_sum) - (sum(gen_ai_client_token_usage_sum offset $__range) or vector(0)))",
          "legendFormat": "tokens",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#83d8c4"
