# ── Lab User Identity (set this per VM for multi-user lab isolation) ──────────
# Each user sets their own unique ID (e.g. user01, user02, john, etc.)
# This tags ALL telemetry in Splunk so you can filter per user.
LAB_USER_ID=pod01

# ── AWS Bedrock ───────────────────────────────────────────────────────────────
# Set AWS_BEDROCK_MODEL_ID to use Bedrock as the LLM backend.
# When set, Bedrock takes priority over Azure OpenAI and NIM.
# Recommended models (must be enabled in your AWS account):
#   amazon.nova-lite-v1:0         — fast, cheap, good for demos
#   amazon.nova-pro-v1:0          — better quality
#   anthropic.claude-3-5-haiku-20241022-v1:0  — fast Claude, excellent tool calling
# AWS_BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AWS_BEDROCK_MODEL_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=



# ── NVIDIA NIM ────────────────────────────────────────────────────────────────
# One key used for everything: Docker login, NIM container, and API calls
# Get it at: https://ngc.nvidia.com → top-right menu → Setup → Generate API Key
NGC_API_KEY=
NVIDIA_NIM_BASE_URL=
NVIDIA_NIM_MODEL=


# ── Splunk Observability Cloud ────────────────────────────────────────────────
SPLUNK_ACCESS_TOKEN=
SPLUNK_REALM=

# ── Splunk Platform (HEC) ─────────────────────────────────────────────────────
SPLUNK_HEC_TOKEN=
SPLUNK_HEC_ENDPOINT=
SPLUNK_HEC_INDEX=

# ── DeepEval ──────────────────────────────────────────────────────────────────
DEEPEVAL_LLM_BASE_URL=
DEEPEVAL_LLM_MODEL=
DEEPEVAL_LLM_PROVIDER=
DEEPEVAL_LLM_API_KEY=
DEEPEVAL_LLM_EXTRA_HEADERS=

LLM_BACKEND=bedrock



# ── Azure OpenAI ─────────────────────────────────────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=
OPENAI_MODEL=

# ── Session 1: Backend-Pluggable Observability (Docker/K8s) ─────────────────
# Select active backend profile for observability stack: oss | splunk | thirdparty
OBSERVABILITY_BACKEND=oss

# OTEL resource metadata consumed by app instrumentation
OTEL_SERVICE_NAME=travel-planner
OTEL_SERVICE_VERSION=0.1.0
OTEL_DEPLOYMENT_ENVIRONMENT=local
OTEL_SERVICE_INSTANCE_ID=local-dev

# OSS profile endpoints (local defaults)
TEMPO_OTLP_ENDPOINT=tempo:4317
LOKI_OTLPHTTP_ENDPOINT=http://loki:3100/otlp

# Third-party OTLP profile (set when OBSERVABILITY_BACKEND=thirdparty)
THIRDPARTY_OTLP_TRACES_ENDPOINT=
THIRDPARTY_OTLP_METRICS_ENDPOINT=
THIRDPARTY_OTLPHTTP_LOGS_ENDPOINT=
THIRDPARTY_OTLP_AUTH_HEADER=

# Local Grafana credentials
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# Local Langfuse settings
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=langfuse
LANGFUSE_DB_NAME=langfuse
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_SALT=change-me
LANGFUSE_NEXTAUTH_URL=http://localhost:3001